# Interakt search index.
# SEARCH_INDEX_ID is the index UUID, not its name. Copy it from the interakt UI
# (the URL of the medusa-products index page) — the lookup-by-name API route
# requires a browser session, so it cannot be curled with the ingestion key.
# The key must be scoped to that index with both `write` and `delete` operations.
SEARCH_INDEX_URL=http://localhost:3000
SEARCH_INDEX_ID=
SEARCH_INDEX_API_KEY=
SEARCH_INDEX_CURRENCY=usd
